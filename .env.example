# App
APP_BASE_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters

# Postgres
# For docker-compose.prod.yml, set POSTGRES_PASSWORD and let compose build DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://morti:replace-with-a-long-random-password@localhost:5432/morti

# Postmark
# Required for real email sign-in. Not needed when LOCAL_AUTH_BYPASS=true in Nuxt dev mode.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound

# Cloudflare Workers AI. Optional unless prompt furniture generation is enabled.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-120b
NUXT_PUBLIC_FEATURES_PROMPT_FURNITURE=false

# Optional analytics. Leave blank for self-hosted/open-source installs.
NUXT_PUBLIC_ANALYTICS_SCRIPT_SRC=
NUXT_PUBLIC_ANALYTICS_SITE_ID=
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=
NUXT_PUBLIC_POSTHOG_UI_HOST=
NUXT_PUBLIC_POSTHOG_DEBUG=false

# Optional legacy demo import script.
POCKETBASE_DEMOS_URL=
DEMO_OWNER_ID=legacy_demo_owner
DEMO_OWNER_EMAIL=demo@example.invalid

# Local development only. Keep false in production.
AI_FURNITURE_ALLOW_LOCAL_UNAUTH=false
LOCAL_AUTH_BYPASS=false
