# App
APP_BASE_URL=https://your-morti-domain.example
AUTH_SECRET=replace-with-at-least-32-random-characters

# Postgres
# For docker-compose.prod.yml, set POSTGRES_PASSWORD and let compose build DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://morti:replace-with-a-long-random-password@localhost:5432/morti

# Postmark
POSTMARK_SERVER_TOKEN=replace-with-postmark-server-api-token
POSTMARK_FROM_EMAIL=auth@your-verified-domain.example
POSTMARK_MESSAGE_STREAM=outbound

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_AI_API_TOKEN=replace-with-workers-ai-api-token
CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-120b
NUXT_PUBLIC_FEATURES_PROMPT_FURNITURE=false

# Local development only. Keep false in production.
AI_FURNITURE_ALLOW_LOCAL_UNAUTH=false
LOCAL_AUTH_BYPASS=false
